  "observations": {
    "material_to_texture": "Matched by the referenced TXOB texture name. Object-to-material indices are [0,4,3,1,2,5], not identity.",
    "layout_correction": "SPICA GfxMaterialColor includes CommandCache at material+0x100. Cull/depth/sampler offsets in this report follow the typed SPICA structures and original command words; the older Ohana reader omits the color command-cache word and reads sampler fields before its typed header.",
    "depth_mask": "Each selected depth command writes only byte0 of GPUREG_DEPTH_COLOR_MASK (header0x00010107). Upper-byte color/depth-write bits are unknown from that packet. Preview depth_write follows declared GfxFragOpDepth.Flags bit1; missing color-write mask explicitly falls back to RGBA. This is a preview interpretation, not a reconstructed full command-buffer state.",
    "blending": "The four enabled blended materials use ADD with source-alpha and one-minus-source-alpha for both RGB and alpha. Alpha result is sourceAlpha^2 + destinationAlpha*(1-sourceAlpha), distinct from Porter-Duff source-over alpha.",
    "orientation": "Pinned SPICA TextureConverter.cs52 and TextureCompression.cs42 reverse decoded row Y to Height-1-Y. H3DTexture.cs114 calls those converters and Rendering/Texture.cs uploads their output directly. Our decoder keeps tile-row order; converting V to1-V reproduces that row reversal when sampling top-down images.",
    "ordering": "Pinned SPICA Gfx.cs426 assigns material TranslucencyKind to mesh Layer; Rendering/Model.cs83 sorts each layer by Priority, and516 renders layers0..3. Gfx.cs500 reverses layer1 explicitly as a workaround. The preview sorts ascending translucency kind, then priority, retaining original object order for ties; it does not adopt that workaround. Expected selected-sample draw indices [0,2,5,3,4,1].",
    "shader_scope": "Material flags0x11 and nontrivial six-stage TEV state are present. Rendering intentionally uses unlit texture-times-vertex-color; full TEV, lighting, fog, shader behavior and game draw ordering are not reconstructed."
  },
  "reproduction": {
    "inputs": "Obtain the independently extracted a/1/0/2 entry0 subentry0 member and verify the SHA256 above. No original member or vertex bytes are tracked.",
    "local_oracle": "outputs/native-textured-model/independent-materials.py (ignored)",
    "oracle_sha256": "3d5ac4c0ec13189a9fd67dfa6a6e1f3836b14a89c0b1aea35f2eec7632bb1635",
    "oracle_algorithm": "Resolve CMDL through DATA slot0 DICT; resolve material DICT at CMDL+0xc0, object table+0xb8, shape table+0xc8. Resolve MTOB mapper+0x274, mapper TXOB reference+8, sampler+12, fragment+0x288. Read source values at offsets described by pinned primary types and the metadata above; command fields include byte write masks. For each object, follow its shape index; resolve stream groups, attribute table and payload; apply attribute scales and append shape-order UV/color float32 bytes. Compute descriptor index counts and running first_index values. Compare material fields, draw metadata and arrays with px_cgfx_model_decode_textured. All pointers and sizes are sample-specific bounded reads.",
    "compile": "tools/native-build/bin/cc -std=c11 -Wall -Wextra -Werror -O2 -fPIC -shared native/assets/cgfx_model.c -lm -o outputs/native-textured-model/libscene-reference.so",
    "runtime_tests": "source tools/native-sdl/activate.sh && python3 -m unittest discover -s native/tests -p test_model_viewer.py -v",
    "runtime_assertions": [
      "synthetic textured demo inspection/input/capture",
      "raw and literal-LZ11 archive pipelines",
      "V orientation using constant UVs and different top/bottom colors",
      "vertex-color multiplication",
      "GREATER alpha reference127 pass and128 reject for alpha128 texture",
      "source-alpha RGB against known opaque background",
      "unsupported material/UV/texture states reject before SDL/export",
      "original archive bytes remain unchanged; existing archive export destination rejected",
      "two coincident differently colored quads prove translucency preview ordering"
    ]
  },
